CREATE MEMORY TABLE PUBLIC.PROJEKT(PROJEKT_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL,NAZWA VARCHAR(50) NOT NULL,OPIS VARCHAR(1000),DATACZAS_UTWORZENIA TIMESTAMP DEFAULT LOCALTIMESTAMP,DATA_ODDANIA DATE,CONSTRAINT PROJEKT_PK PRIMARY KEY(PROJEKT_ID))
