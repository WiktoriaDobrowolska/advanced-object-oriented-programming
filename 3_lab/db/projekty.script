CREATE MEMORY TABLE PUBLIC.ZADANIE(ZADANIE_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL,NAZWA VARCHAR(50) NOT NULL,OPIS VARCHAR(1000),DATA DATE,DATACZAS_UTWORZENIA TIMESTAMP DEFAULT LOCALTIMESTAMP,PROJEKT_ID INTEGER NOT NULL,CONSTRAINT ZADANIE_PK PRIMARY KEY(ZADANIE_ID),CONSTRAINT ZADANIE_PROJEKT_FK FOREIGN KEY(PROJEKT_ID) REFERENCES PUBLIC.PROJEKT(PROJEKT_ID) ON DELETE CASCADE)
