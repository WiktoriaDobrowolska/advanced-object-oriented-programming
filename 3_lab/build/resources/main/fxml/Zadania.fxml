<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.controller.ZadaniaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lblTytul" text="Zadania dla projektu">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <TableView fx:id="tblZadania" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colZadanieId" prefWidth="75.0" text="ID Zadania" />
                <TableColumn fx:id="colNazwa" prefWidth="150.0" text="Nazwa zadania" />
                <TableColumn fx:id="colOpis" prefWidth="200.0" text="Opis" />
                <TableColumn fx:id="colData" prefWidth="75.0" text="Data" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onActionBtnDodajZadanie" text="Dodaj zadanie" />
                <Button mnemonicParsing="false" onAction="#onActionBtnUsunZadanie" text="Usuń zadanie" />
            </children>
        </HBox>
    </children>
</VBox>